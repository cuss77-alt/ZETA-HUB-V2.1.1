                        originalShadows = Lighting.GlobalShadows
                        originalFogEnd = Lighting.FogEnd
                        Lighting.GlobalShadows = false
                        Lighting.FogEnd = 999999
                        
                        local count = 0
                        for _, v in ipairs(workspace:GetDescendants()) do
                            count = count + 1
                            if v:IsA("BasePart") then
                                originalMaterials[v] = v.Material
                                v.Material = Enum.Material.SmoothPlastic
                            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                                v.Enabled = false
                            end
                            -- Cada 350 objetos descansa un micro-fotograma para no congelar el celular
                            if count % 350 == 0 then
                                RunService.Heartbeat:Wait()
                            end
                        end
                    end)
                end)
            else
                AntiLagBtn.Text = T("alOff")
                AntiLagBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
                AntiLagBtn.BackgroundColor3 = Color3.fromRGB(18, 23, 32)
                
                task.spawn(function()
                    pcall(function()
                        Lighting.GlobalShadows = originalShadows
                        Lighting.FogEnd = originalFogEnd
                        local count = 0
                        for part, mat in pairs(originalMaterials) do
                            count = count + 1
                            if part and part.Parent then 
                                part.Material = mat 
                            end
                            if count % 350 == 0 then
                                RunService.Heartbeat:Wait()
                            end
                        end
                        table.clear(originalMaterials)
                        for _, v in ipairs(workspace:GetDescendants()) do
                            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                                v.Enabled = true
                            end
                        end
                    end)
                end)
            end
