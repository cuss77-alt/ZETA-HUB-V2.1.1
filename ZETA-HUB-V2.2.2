        -- // MOTOR LIGERO OPTIMIZADO // --
        local hueVal = 0
        local throttle = 0

        local mainLoopConn
        mainLoopConn = RunService.RenderStepped:Connect(function()
            throttle = throttle + 1
            
            hueVal = (hueVal + 0.01) % 1
            local currentRGBColor = Color3.fromHSV(hueVal, 1, 1)

            FOVFrameUI.Size = UDim2.new(0, FOVRadius * 2, 0, FOVRadius * 2)
            UIStrokeFOV.Color = FOVRgb and currentRGBColor or Color3.fromRGB(0, 230, 118)

            if AimbotEnabled then
                local closestTarget, shortestDist = nil, FOVRadius

                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")

                        if humanoid and rootPart and humanoid.Health > 0 then
                            local isPlayer = Players:GetPlayerFromCharacter(obj)
                            local validTarget = true

                            if isPlayer then
                                if isPlayer == LocalPlayer or (isPlayer.Team and LocalPlayer.Team and isPlayer.Team == LocalPlayer.Team) then
                                    validTarget = false
                                end
                            end

                            if validTarget then
                                local targetPartObj = obj:FindFirstChild(TargetPart) or rootPart
                                if targetPartObj then
                                    local pos, onScreen = Camera:WorldToViewportPoint(targetPartObj.Position)
                                    if onScreen then
                                        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                                        local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                                        if dist < shortestDist then
                                            shortestDist = dist
                                            closestTarget = targetPartObj
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                if closestTarget then
                    local targetPosition = closestTarget.Position
                    if PredictionEnabled and closestTarget.Parent and closestTarget.Parent:FindFirstChild("HumanoidRootPart") then
                        local root = closestTarget.Parent.HumanoidRootPart
                        targetPosition = targetPosition + (root.Velocity * 0.11)
                    end
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPosition), 0.45)
                end
            end

            if throttle % 4 == 0 then
                local finalWHColor = Color3.fromRGB(0, 230, 118)
                if WHColorMode == "Red" then finalWHColor = Color3.fromRGB(255, 50, 50)
                elseif WHColorMode == "Blue" then finalWHColor = Color3.fromRGB(50, 150, 255)
                elseif WHColorMode == "RGB" then finalWHColor = currentRGBColor end

                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            if WallhackEnabled then
                                if not obj:FindFirstChild("ZetaUltimateHL") then
                                    local hl = Instance.new("Highlight")
                                    hl.Name = "ZetaUltimateHL"
                                    hl.Adornee = obj
                                    hl.FillColor = finalWHColor
                                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                    hl.Parent = obj
                                else
                                    obj.ZetaUltimateHL.FillColor = finalWHColor
                                end
                            else
                                if obj:FindFirstChild("ZetaUltimateHL") then
                                    obj.ZetaUltimateHL:Destroy()
                                end
                            end
                        end
                    end
                end
            end
        end)

        table.insert(activeConnections, mainLoopConn)

    else
        VerifyBtn.Text = "[-] KEY INCORRECTA [-]"
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        task.wait(1.5)
        VerifyBtn.Text = "[ VERIFICAR KEY ]"
        VerifyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
    end
end)
